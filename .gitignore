# ─────────────────────────────────────────────────────────────────────────────
# Q-BE ECOSYSTEM — HIGIENE GLOBAL DE REPOSITORIO
# Toda exclusión es deliberada. No se ignora `data/` completo: la evidencia
# fáctica JSON/CSV de investigación se versiona; solo se excluyen artefactos
# generados, bases SQLite y secretos.
# ─────────────────────────────────────────────────────────────────────────────

# Entornos virtuales y cachés de herramientas
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.bt_run/

# Logs y trazas
*.log
*.log.*
logs/

# Bases de datos SQLite y sus artefactos WAL/SHM
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# [P0 #4] Copias congeladas del corpus (se regeneran; jamás se versionan)
data/snapshots/*.db
data/snapshots/*.db-shm
data/snapshots/*.db-wal

# Salidas generadas y artefactos de cobertura
data/output/*
!data/output/.gitkeep
!data/output/research_feature_matrix.csv
!data/output/Q-BE_Manus_Dataset_97_canonico.csv
qbe_business/data/
qbe_observatory/data/
qbe_storage/data/
qbe_ingestion/data/
htmlcov/
.coverage
coverage.xml

# Secretos y configuración local
.env
.env.*
!.env.example

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.vscode/settings.json

# Dumps brutos de FootyStats (59.5 MB)
data/raw_footystats/
data/extracted_footystats/temporada_2015_2016.json
data/extracted_footystats/temporada_2016_2017.json
data/extracted_footystats/temporada_2017_2018.json
data/extracted_footystats/temporada_2018_2019.json
data/extracted_footystats/temporada_2019_2020.json
data/extracted_footystats/temporada_2020_2021.json
data/extracted_footystats/temporada_2021_2022.json
data/extracted_footystats/temporada_2022_2023.json
data/extracted_footystats/temporada_2023_2024.json
data/extracted_footystats/temporada_2024_2025.json
data/extracted_footystats/temporada_2025_2026.json
data/extracted_footystats/temporada_2026_2027.json
